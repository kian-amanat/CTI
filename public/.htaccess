# ─────────────────────────────────────────────────────────────────────────────
# chasbteyfiran.com: static site exported by Next.js (the `out/` folder).
# Upload this file together with everything inside `out/` to the web root (public_html).
# Works on LiteSpeed and Apache. Static exports can't set redirects or headers themselves,
# so they live here.
#
# NOTE: this replaces WordPress's .htaccess. If WordPress stays on the same host folder
# (for example in /blog/), keep WordPress's own rules in that sub-folder instead.
# ─────────────────────────────────────────────────────────────────────────────

DirectoryIndex index.html
Options -Indexes
AddDefaultCharset UTF-8

# MIME types that older Apache/LiteSpeed builds may not know (the cache and compression rules below depend on them)
<IfModule mod_mime.c>
  AddType font/woff2 .woff2
  AddType image/webp .webp
  AddType application/manifest+json .webmanifest
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On

  # 1) One canonical host, in ONE hop: www.chasbteyfiran.com -> https://chasbteyfiran.com
  #    (even http://www goes straight to https://, never through an intermediate address)
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

  # 2) Always HTTPS (also works behind a CDN/proxy that terminates SSL)
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # 3) /index.html and /folder/index.html are the same page as / and /folder/: send people and Google to the clean URL
  RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.html[\s?] [NC]
  RewriteRule ^(.*/)?index\.html$ /$1 [L,R=301]
</IfModule>

# 4) Branded 404 page (generated by Next.js)
ErrorDocument 404 /404.html

# 5) Compression (JavaScript is served as text/javascript by most servers, application/javascript by some: list both)
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml text/javascript application/javascript application/x-javascript application/json application/ld+json application/manifest+json application/xml image/svg+xml image/x-icon
</IfModule>

# 6) Browser caching
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 hour"
  # pages: always revalidate so edits show up immediately
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/xml "access plus 1 hour"
  ExpiresByType text/plain "access plus 1 hour"
  # images WITHOUT a hash in their name (logo, icons, Open Graph image): a week, they change rarely
  ExpiresByType image/webp "access plus 1 week"
  ExpiresByType image/png "access plus 1 week"
  ExpiresByType image/jpeg "access plus 1 week"
  ExpiresByType image/svg+xml "access plus 1 week"
  # the hashed files in /_next/static/ never change
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
</IfModule>

# 7) Headers
<IfModule mod_headers.c>
  # Files whose NAME contains a content hash can never change under the same name, so the browser may keep them
  # for a year without asking again: every product photo (name.<8 hex>.webp) and everything Next.js builds.
  <FilesMatch "\.[0-9a-f]{8}\.webp$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(js|css|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"

  # HSTS is off on purpose: browsers remember it, so turn it on only after https://chasbteyfiran.com has worked
  # (valid certificate, no mixed content) for a few days. Then remove the leading # from the next line.
  # Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>
