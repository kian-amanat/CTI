# ─────────────────────────────────────────────────────────────────────────────
# chasbteyfiran.com: static site exported by Next.js (the `out/` folder).
# Upload this file together with everything inside `out/` to the web root (public_html).
# Works on LiteSpeed and Apache. Static exports can't set redirects or headers themselves,
# so they live here.
#
# NOTE: this replaces WordPress's .htaccess. If WordPress stays on the same host folder
# (for example in /blog/), keep WordPress's own rules in that sub-folder instead.
# ─────────────────────────────────────────────────────────────────────────────

DirectoryIndex index.html
Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On

  # 1) Always HTTPS (also works behind a CDN/proxy that terminates SSL)
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # 2) One canonical host: www.chasbteyfiran.com -> chasbteyfiran.com
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]
</IfModule>

# 3) Branded 404 page (generated by Next.js)
ErrorDocument 404 /404.html

# 4) Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml application/xml application/javascript application/json application/manifest+json image/svg+xml
</IfModule>

# 5) Browser caching
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 hour"
  # pages: always revalidate so edits show up immediately
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/xml "access plus 1 hour"
  ExpiresByType text/plain "access plus 1 hour"
  # product photos and icons (re-uploaded under the same name only when the catalog changes)
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  # fonts and the hashed files in /_next/static/ never change
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
</IfModule>

# 6) Basic security headers
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>
