# Production domain (canonical URLs, sitemap, Open Graph). Defaults to https://chasbteyfiran.com
NEXT_PUBLIC_SITE_URL=https://chasbteyfiran.com

# true on staging/preview deployments: adds noindex and blocks crawling in robots.txt
NEXT_PUBLIC_NOINDEX=false

# Google Search Console: the content="..." value of the "HTML tag" verification method (optional)
NEXT_PUBLIC_GOOGLE_VERIFICATION=
